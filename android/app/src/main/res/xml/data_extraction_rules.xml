<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (targetSdk 31) backup rules.
  Backup and device-transfer are disabled app-wide so that workspace data —
  and anything cached inside it — is never copied off the device by
  Google's cloud backup infrastructure.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
